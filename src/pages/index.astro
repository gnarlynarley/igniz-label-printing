---
import Canvas from '../components/Canvas.svelte';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Label printing</title>
  </head>
  <body>
    <Canvas client:load />

    <style>
      * {
        margin: 0;
      }
      @media screen {
        body {
          background: black;
        }
      }

      @media print {
        body {
          width: 6in;
          height: 4in;
        }
      }
    </style>
  </body>
</html>
